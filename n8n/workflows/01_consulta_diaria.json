{
  "id": "LitMonitorConsulta01",
  "name": "LITIGATION MONITOR — Consulta diária e alertas",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "name": "Todos os dias às 7h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "id": "33cf6bad-9187-5a04-a974-57f581f45172"
    },
    {
      "parameters": {},
      "name": "Executar agora (teste)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ],
      "id": "9ecf1e62-9b8b-5106-8c03-4c5c6e0980f2"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/consultas",
        "options": {
          "timeout": 1800000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ reler_planilha: true }) }}"
      },
      "name": "Consultar processos (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "id": "6d6a6625-ac07-589a-ae31-d59c718b6879"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://api:8000/alertas/pendentes",
        "options": {
          "timeout": 30000
        }
      },
      "name": "Buscar alertas pendentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "id": "639a4bce-b41a-5964-aa56-f1250d07482a"
    },
    {
      "parameters": {
        "fieldToSplitOut": "alertas",
        "options": {}
      },
      "name": "Separar alertas",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        300
      ],
      "id": "03a2297b-f391-5162-b23a-8237debe63a0"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "canal-email",
              "leftValue": "={{ $json.email.para }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Tem e-mail configurado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "id": "48edec50-cdbb-5daf-a94d-6d6435138e1b"
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.email.de }}",
        "toEmail": "={{ $json.email.para }}",
        "subject": "={{ $json.email.assunto }}",
        "emailFormat": "html",
        "html": "={{ $json.email.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "name": "Enviar alerta por e-mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1200,
        200
      ],
      "id": "00a70f1e-772b-5b86-ae5f-6fb290dd7c9f",
      "credentials": {
        "smtp": {
          "id": "LitMonitorGmail01",
          "name": "Gmail (Litigation Monitor)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/notificacoes",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tipo: $('Separar alertas').item.json.tipo, situacao: ($json.error ? 'falha' : 'enviada'), movimentacao_id: $('Separar alertas').item.json.movimentacao_id, destino: 'Gmail' }) }}"
      },
      "name": "Registrar envio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        200
      ],
      "id": "e31fc8ee-9099-59f2-90f5-8ba8f47b8b43"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/notificacoes",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tipo: $json.tipo, situacao: 'sem_canal', movimentacao_id: $json.movimentacao_id, destino: 'Gmail' }) }}"
      },
      "name": "Registrar sem canal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        420
      ],
      "id": "de1d8201-e40f-5c17-bfbd-628e5dbcf77d"
    }
  ],
