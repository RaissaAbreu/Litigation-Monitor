        "smtp": {
          "id": "LitMonitorGmail01",
          "name": "Gmail (Litigation Monitor)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/notificacoes",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tipo: 'resumo_diario', situacao: ($json.error ? 'falha' : 'enviada'), movimentacao_id: null, destino: 'Gmail' }) }}"
      },
      "name": "Registrar envio",
