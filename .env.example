# Copie para .env e ajuste. Nunca versione o .env com URLs reais.

# Fonte inicial: "demo" (dados fictícios, sem rede) ou "datajud" (API Pública do CNJ).
# O painel permite trocar a fonte; a escolha fica salva no banco.
LM_FONTE=demo

# Chave pública do DataJud. Deixe vazio para usar a chave divulgada pelo CNJ em
# https://datajud-wiki.cnj.jus.br/api-publica/acesso — se o CNJ trocar a chave, cole a nova aqui.
DATAJUD_API_KEY=

# Alertas por e-mail (Gmail pessoal funciona). A senha NÃO é a do Gmail: é uma "senha de app"
# de 16 letras, criada em https://myaccount.google.com/apppasswords (exige verificação em duas etapas).
GMAIL_USUARIO=
GMAIL_SENHA_APP=
# Quem recebe os alertas (vários: separe por vírgula). Vazio = o próprio GMAIL_USUARIO.
EMAIL_ALERTAS=

# Endereços usados nos botões dos e-mails.
LM_URL_PAINEL=http://localhost:8501
LM_URL_API=http://localhost:8000

# Planilha relida antes de cada consulta agendada. Para usar: coloque o arquivo em ./planilhas/processos.xlsx
# e tire o # da linha abaixo. Sem isso, a carteira é a importada pelo painel.
# LM_PLANILHA=/planilhas/processos.xlsx

# Alertas
LM_DIAS_ALERTA=3                 # dias antes do vencimento para o alerta "prazo próximo"
LM_HORAS_REPETICAO_VENCIDO=24    # repetição do alerta de prazo vencido
LM_RELEVANCIA_ALERTA=Média       # Alta, Média ou Baixa
LM_DIAS_RETROATIVOS=15           # na 1ª consulta, eventos relevantes desta janela contam como novos

# Versão da imagem do n8n (linha 1.x, cujos comandos de importação/ativação os fluxos usam).
N8N_VERSAO=1.123.93
